# OpenRouter API key used to call the upstream LLM provider (required)
OPENROUTER_API_KEY=your-openrouter-key-here

# libSQL endpoint for the audit_logs and users database (required, no default).
# A sqlite:/// value is a startup error - PRD-007 removed the file fallback.
# Local dev server: http://127.0.0.1:8080
DATABASE_URL=libsql://your-database-your-org.turso.io

# Bearer token for the Turso database (required for libsql:// and https://
# endpoints; leave empty for the local http:// dev server, which takes no token)
TURSO_AUTH_TOKEN=

# Whether startup touches the database at all: the reachability guard and the
# schema migration (default true). Build-time only - the Docker builder stage
# sets it false so `reflex export` can import the app with no database. Leave it
# unset in any deployment; false there boots an app whose schema was never
# created.
# DB_BOOTSTRAP_ENABLED=true

# Port the FastAPI server listens on
PORT=8000

# Host/interface the server binds to
HOST=0.0.0.0

# Shared-secret bearer token required to call /audit and /stats (required)
ADMIN_TOKEN=change-me

# Deny-by-default RBAC enforcement; false preserves pre-RBAC PRD-001 behavior
# as a documented migration escape hatch (true/false)
RBAC_ENABLED=true

# Role assigned to a user created without an explicit --role
RBAC_DEFAULT_ROLE=user

# Optional path to a JSON role->permission matrix; empty uses the built-in default
RBAC_ROLES_FILE=

# Comma-separated models callers may request; enforced server-side per role
MODEL_ALLOWLIST=gpt-4,claude-3-sonnet,openai/gpt-4o,anthropic/claude-3.5-sonnet

# Log verbosity (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Master switch for PII redaction on prompts and responses (true/false)
PII_REDACTION_ENABLED=true

# Minimum Presidio confidence to mask an entity - low by design, favors over-masking
PII_SCORE_THRESHOLD=0.35

# Comma-separated Presidio entity types to detect and mask
PII_ENTITIES=PERSON,EMAIL_ADDRESS,PHONE_NUMBER,CREDIT_CARD,US_SSN,IBAN_CODE,LOCATION

# spaCy model backing Presidio's analyzer (install with: python -m spacy download en_core_web_lg)
PII_NLP_MODEL=en_core_web_lg

# Master switch for chat transcript persistence (true/false). false writes no
# transcript, reads none, shows no session rail, and the chat behaves exactly
# as it did before PRD-008 - the supported configuration for a deployment that
# must not hold prompt text at rest
CHAT_HISTORY_ENABLED=true

# Maximum sessions listed per user in the session rail; must be at least 1
CHAT_SESSION_LIMIT=50
