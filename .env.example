# OpenRouter API key used to call the upstream LLM provider (required)
OPENROUTER_API_KEY=your-openrouter-key-here

# libSQL endpoint for the audit_logs and users database (required, no default).
# A sqlite:/// value is a startup error - PRD-007 removed the file fallback.
# Local dev server: http://127.0.0.1:8080
DATABASE_URL=libsql://your-database-your-org.turso.io

# Bearer token for the Turso database (required for libsql:// and https://
# endpoints; leave empty for the local http:// dev server, which takes no token)
TURSO_AUTH_TOKEN=

# Whether startup touches the database at all: the reachability guard and the
# schema migration (default true). Build-time only - the Docker builder stage
# sets it false so `reflex export` can import the app with no database. Leave it
# unset in any deployment; false there boots an app whose schema was never
# created.
# DB_BOOTSTRAP_ENABLED=true

# Port the FastAPI server listens on
PORT=8000

# Host/interface the server binds to
HOST=0.0.0.0

# Break-glass bearer token: always resolves to the admin role, independent of
# the users table (required). Never accepted on /v1; BREAK_GLASS_INGRESSES can
# also refuse it on /query and the chat UI. The admin console signs in with it
ADMIN_TOKEN=change-me

# Deny-by-default RBAC enforcement; false preserves pre-RBAC PRD-001 behavior
# as a documented migration escape hatch (true/false)
RBAC_ENABLED=true

# Role assigned to a user created without an explicit --role
RBAC_DEFAULT_ROLE=user

# Optional path to a JSON role->permission matrix; empty uses the built-in default
RBAC_ROLES_FILE=

# Comma-separated models callers may request; enforced server-side per role
MODEL_ALLOWLIST=gpt-4,claude-3-sonnet,openai/gpt-4o,anthropic/claude-3.5-sonnet

# Log verbosity (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Master switch for PII redaction under every profile, chat and code: prompts,
# history, and responses where the profile redacts them (true/false)
PII_REDACTION_ENABLED=true

# Minimum Presidio confidence to mask an entity under the chat profile - low by
# design, favors over-masking (code uses PII_SCORE_THRESHOLD_CODE)
PII_SCORE_THRESHOLD=0.35

# Comma-separated Presidio entity types to detect and mask under the chat
# profile (code uses PII_ENTITIES_CODE)
PII_ENTITIES=PERSON,EMAIL_ADDRESS,PHONE_NUMBER,CREDIT_CARD,US_SSN,IBAN_CODE,LOCATION

# spaCy model backing the chat profile's analyzer, and code's only if
# PII_ENTITIES_CODE names an NER type (PERSON, LOCATION, ORGANIZATION, NRP,
# DATE_TIME) (install with: python -m spacy download en_core_web_lg)
PII_NLP_MODEL=en_core_web_lg

# Master switch for chat transcript persistence (true/false). false writes no
# transcript, reads none, shows no session rail, and the chat behaves exactly
# as it did before PRD-008 - the supported configuration for a deployment that
# must not hold prompt text at rest
CHAT_HISTORY_ENABLED=true

# Maximum sessions listed per user in the session rail; must be at least 1
CHAT_SESSION_LIMIT=50

# Multi-turn pipeline (PRD-010)

# Seconds to wait for the upstream provider before giving up; must be > 0.
# Replaces the old hard-coded 30s, too short for a long conversation
OPENROUTER_TIMEOUT_SECONDS=120.0

# Upstream base URL (PRD-015); /chat/completions is appended. Must be https://,
# or http:// only on a loopback host (127.0.0.1, localhost, ::1), which is how
# the E2E stub upstream is reached. Whoever controls this host receives
# OPENROUTER_API_KEY (PRD-015 T10), so treat changing it like handing out the key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Most messages one conversation may send to the pipeline, new turn included;
# checked first, and the only limit named when both are exceeded (min 1)
CONTEXT_MAX_MESSAGES=100

# Most characters across message contents in one conversation - characters,
# not tokens, which is a deliberate proxy for ~50k tokens of English (min 1)
CONTEXT_MAX_CHARACTERS=200000

# Threads in the dedicated pipeline executor; keeps /health and other queries
# answering while long upstream calls are in flight (min 1)
PIPELINE_MAX_WORKERS=32

# Reports section (/reports). Directory holding PRDs/, stories/ and reports/;
# empty means .agents at the repository root
REPORTS_AGENTS_DIR=

# Repository a report's commit SHA links to ({REPORTS_REPO_URL}/commit/{sha})
REPORTS_REPO_URL=https://github.com/The-Spik3r/harness-ai

# Pattern policy (PRD-011)

# Optional path to a YAML file of pattern lists and profiles; empty uses the
# built-in policy and reads no file. A file replaces the built-in policy
# wholesale - it is not merged into it. A working sample that reproduces the
# built-in policy: examples/patterns.yaml (README, "Pattern policy")
PATTERNS_FILE=

# Profile used by any call site that does not pass one - /query and the chat
# UI. Must name a profile the loaded policy defines, checked when the policy
# loads at startup rather than when this setting is read
PATTERN_PROFILE_DEFAULT=chat

# Whether match: regex lists are permitted at all (true/false). Off by
# default: a file containing a regex list fails startup until this is true
PATTERNS_ALLOW_REGEX=false

# Most characters of any one message a single pattern scan runs over; a longer
# message is truncated for matching only, never for the upstream call (min 1)
PATTERN_MAX_SCAN_CHARACTERS=1000000

# PII for code (PRD-012)
# Used only where a call site runs the code profile; /query and the chat UI run
# chat, and no request can choose a profile (README, "PII redaction")

# Comma-separated Presidio entity types to detect and mask under code. With no
# NER type in the list, a tokenizer-only analyzer runs and en_core_web_lg is
# never loaded for code. Adding PERSON or LOCATION masks names and places, at
# en_core_web_lg's cost
PII_ENTITIES_CODE=EMAIL_ADDRESS,PHONE_NUMBER,CREDIT_CARD,US_SSN,IBAN_CODE

# Minimum Presidio confidence to mask an entity under code, 0 to 1. 0.40 is the
# highest value that still found every prose sample in the benchmark
PII_SCORE_THRESHOLD_CODE=0.40

# Most characters per request that code's redaction will analyze - fenced
# blocks and line breaks not counted. Over it the request is refused (fail
# closed), never forwarded unmasked (min 1)
PII_MAX_CHARACTERS_CODE=200000

# Redact the model's response under code (true/false). Off: a coding agent
# writes its response into files, and a placeholder there corrupts them
PII_CODE_REDACT_OUTPUT=false

# Redact system turns under code (true/false). Off: it is the client's own
# prompt, and the largest fixed cost per request
PII_CODE_REDACT_SYSTEM=false

# Skip fenced code blocks under code (true/false). PII inside a fence reaches
# the provider unmasked; prose around it, and inline backtick spans, are still
# masked
PII_CODE_SKIP_CODE_BLOCKS=true

# Usage limits (PRD-013)
# On by default: an upgraded deployment is limited from its first boot. The
# defaults are starting points, chosen so ordinary chat and script use never
# reaches them (README, "Usage limits")

# Master switch for the usage gate and the token charge (true/false). false
# writes and reads no counter, and each request makes the round trips it made
# before PRD-013. RBAC_ENABLED=false does not turn limits off
USAGE_LIMITS_ENABLED=true

# Tokens per user per UTC day, by role: role=value pairs with a required *
# entry; each value an integer >= 1 or unlimited (e.g. *=1000000,admin=unlimited).
# Overridden per user with scripts/manage_users.py set-limits
USAGE_DAILY_TOKEN_BUDGET=*=1000000

# Authorized attempts per user per minute, by role, in the same shape
# (e.g. *=60,admin=120). A fixed window on the database clock
USAGE_REQUESTS_PER_MINUTE=*=60

# Ingresses on which ADMIN_TOKEN may submit queries: any subset of query and
# chat, possibly empty. v1 is rejected at startup - the token is never
# accepted there, and this setting can only narrow where it is
BREAK_GLASS_INGRESSES=query,chat


# OpenAI-compatible endpoint (PRD-015; README, "OpenAI-compatible endpoint")

# Mount POST /v1/chat/completions and GET /v1/models (true/false). false makes
# /v1/* a 404 and leaves /query and the chat UI exactly as they are
V1_ENABLED=true

# Seconds between ': keep-alive' lines while a stream: true request waits for
# the pipeline; > 0 and <= 60. Keeps proxies and clients from timing out
V1_SSE_KEEPALIVE_SECONDS=10

# Tool calling on /v1 (PRD-017; docs/features.md, "Tool calling"). Write the
# ACTION_POLICY_FILE below first: it decides every tool call before the client sees it

# Admit tools, tool_choice, parallel_tool_calls and tool turns on /v1 (true/false).
# false keeps PRD-015's tools_not_supported refusal byte for byte. true sends each
# tool call the model returns through the action policy; the harness never runs a
# tool. functions / function_call are refused either way. Read at startup
V1_TOOLS_ENABLED=false

# Comma list of the models a tools request may name, exact match. Empty means no
# extra restriction. Every entry must also be in MODEL_ALLOWLIST (a startup error
# otherwise). When set it applies to every caller, admin included
V1_TOOL_MODELS=

# Action policy rules (PRD-016; docs/features.md, "Action policy rules")
# Decides every /v1 tool call while V1_TOOLS_ENABLED=true (PRD-017)

# Optional path to a YAML action policy; empty uses the built-in policy and reads
# no file. A file replaces each section it states wholesale (rules: merges per
# rule id) and an invalid one stops startup. Working sample:
# examples/action_policy.yaml. Relative workspace roots are refused
ACTION_POLICY_FILE=

# Ceiling on characters in one tool call's arguments; over it the call is denied as
# tool.malformed (min 1)
ACTION_MAX_ARGUMENT_CHARACTERS=100000

# sqlglot dialect for SQL tools' statements; empty uses the generic dialect. An
# unknown name stops startup. SQL embedded in a shell command (psql, mysql, sqlite3)
# always uses that client's own dialect
ACTION_SQL_DIALECT=

# Where the audit journal lives: the local file an audit row is written to when the
# database cannot take it (PRD-018). It holds raw prompt previews, so the directory is
# created 0700 and its files 0600; it is empty while the database is reachable. Docker
# compose overrides this with the harness-audit-buffer volume at
# /var/lib/harness/audit-buffer, so a value here does not move it off the volume
AUDIT_BUFFER_DIR=./var/audit-buffer

# The journal's capacity in bytes (64 MiB). An append past it fails closed and the
# request gets a 503. Must be at least PIPELINE_MAX_WORKERS x 65536 x 2 (4 MiB at the
# default 32 workers); a smaller value stops startup
AUDIT_BUFFER_MAX_BYTES=67108864

# Path of the drain flag. While the file exists /ready answers 503 "draining" and the
# load balancer stops sending new requests to this instance (PRD-019). Must be a
# non-empty absolute path; scripts/rolling_restart.sh creates it in the container
DRAIN_FILE=/tmp/harness-drain

# Deadline in seconds of the SELECT 1 behind /ready (PRD-019). Greater than 0 and at
# most 10; keep it under the balancer's 3 s health timeout
READY_DB_TIMEOUT_SECONDS=2.0

# Only for docker-compose.lb.yml: the secret that signs the balancer's affinity cookie.
# Pass it on the command line or set it here, for example from openssl rand -hex 32;
# compose refuses to start the balancer without it. The application never reads it
# LB_COOKIE_SECRET=

# A Reflex variable, not a harness setting. Leave REFLEX_REDIS_URL unset: setting it
# silently switches Reflex to Redis, which is untested here (PRD-019). Do not add an
# empty assignment
