{"nodes": [{"id": "_agents_reports_prd_007_turso_migration_story_006_libsql_connection_layer_report_document", "label": "STORY-006 Implementation Report: libSQL Connection Layer", "file_type": "document", "source_file": ".agents/reports/PRD-007-turso-migration/STORY-006-libsql-connection-layer.report.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_agents_reports_prd_007_turso_migration_story_006_libsql_connection_layer_report_process_wide_shared_client", "label": "Process-Wide Shared libSQL Client", "file_type": "rationale", "source_file": ".agents/reports/PRD-007-turso-migration/STORY-006-libsql-connection-layer.report.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Measured, not assumed, that a per-thread client cache -- the plan's supposedly safe default -- actually loses writes under contention (7/8 threads hit TRANSACTION_TIMEOUT, only 29-31/200 rows durable), while one client shared by all threads was safe (0 errors, 200/200 rows durable). The defensive-looking design was the dangerous one; the correct design is the single process-wide client the acceptance criteria literally asked for."}], "edges": [{"source": "_agents_reports_prd_007_turso_migration_story_006_libsql_connection_layer_report_document", "target": "_agents_reports_prd_007_turso_migration_story_001_driver_decision_document", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/reports/PRD-007-turso-migration/STORY-006-libsql-connection-layer.report.md", "source_location": null, "weight": 1.0}, {"source": "_agents_reports_prd_007_turso_migration_story_006_libsql_connection_layer_report_document", "target": "_agents_reports_prd_007_turso_migration_story_004_module_owned_error_surface_report_document", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/reports