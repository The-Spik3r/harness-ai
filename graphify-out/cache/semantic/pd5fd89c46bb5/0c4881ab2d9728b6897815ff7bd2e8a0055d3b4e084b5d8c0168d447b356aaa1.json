{"nodes": [{"id": "_agents_stories_prd_006_admin_console_story_003_admin_token_gate_story", "label": "STORY-003: AdminState token gate \u2014 compare_digest, one generic error, sign-out clears state", "file_type": "document", "source_file": ".agents/stories/PRD-006-admin-console/STORY-003-admin-token-gate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_agents_stories_prd_006_admin_console_story_003_admin_token_gate_risk1_gate_guard", "label": "Risk 1: load() guarded by authentication", "file_type": "rationale", "source_file": ".agents/stories/PRD-006-admin-console/STORY-003-admin-token-gate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AdminState.load() returns immediately and performs no database read when the state is unauthenticated, so an unauthenticated page has no data in state regardless of what renders \u2014 the guard clause defined at the state layer, ahead of and independent from the render-level gate."}, {"id": "_agents_stories_prd_006_admin_console_story_003_admin_token_gate_no_oracle_gate_error", "label": "No-oracle gate refusal", "file_type": "rationale", "source_file": ".agents/stories/PRD-006-admin-console/STORY-003-admin-token-gate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An empty token, a wrong-length token and a wrong token of the correct length all produce the identical gate_error string, and authenticate() compares with secrets.compare_digest after consistent encoding, so no oracle (message or otherwise) distinguishes why authentication failed."}], "edges": [{"source": "_agents_stories_prd_006_admin_console_story_003_admin_token_gate_story", "target": "chat_ui_chat_ui_admin_state_adminstate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/stories/PRD-006-admin-console