{"nodes": [{"id": "_agents_stories_prd_006_admin_console_story_009_admin_shell_and_gate_story", "label": "STORY-009: admin_shell.py \u2014 token gate form, masthead, and the two-view switch", "file_type": "document", "source_file": ".agents/stories/PRD-006-admin-console/STORY-009-admin-shell-and-gate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_agents_stories_prd_006_admin_console_story_009_admin_shell_and_gate_gate_as_state", "label": "Gate as state, not as route", "file_type": "concept", "source_file": ".agents/stories/PRD-006-admin-console/STORY-009-admin-shell-and-gate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The admin pages exist unconditionally; Reflex has no server-side route guard here, so the token check is expressed as the render condition itself, and data is not loaded until it passes."}, {"id": "_agents_stories_prd_006_admin_console_story_009_admin_shell_and_gate_risk6_no_cards_no_accent", "label": "Risk 6: no cards, no accent colour", "file_type": "rationale", "source_file": ".agents/stories/PRD-006-admin-console/STORY-009-admin-shell-and-gate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The KPI-cards-over-striped-table default is the strongest pull in this design space, and the drift arrives one reasonable-looking component at a time, usually as a Radix card imported for convenience. The console introduces no card, no fill and no accent colour beyond the inherited palette, enforced by render invariant tests."}], "edges": [{"source": "_agents_stories_prd_006_admin_console_story_009_admin_shell_and_gate_story", "target": "_agents_stories_prd_006_admin_console_story_003_admin_token_gate_story", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/stories/PRD-006-admin-console/STOR