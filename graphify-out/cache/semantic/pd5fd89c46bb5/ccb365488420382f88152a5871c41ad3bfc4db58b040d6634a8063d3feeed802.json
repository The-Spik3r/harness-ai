{"nodes": [{"id": "agents_plans_prd_005_rbac_completed_story_014_chat_ui_login_plan_doc", "label": "Plan: Chat UI login replaces the free-text user_id prompt", "file_type": "document", "source_file": ".agents/plans/PRD-005-rbac/completed/STORY-014-chat-ui-login.plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "chat_ui_chat_ui_models", "label": "chat_ui/chat_ui/models.py (ChatMessage)", "file_type": "code", "source_file": ".agents/plans/PRD-005-rbac/completed/STORY-014-chat-ui-login.plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "chat_ui_chat_ui_theme", "label": "chat_ui/chat_ui/theme.py", "file_type": "code", "source_file": ".agents/plans/PRD-005-rbac/completed/STORY-014-chat-ui-login.plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_backend_only_reflex_var", "label": "Backend-only Reflex var for session credential", "file_type": "rationale", "source_file": ".agents/plans/PRD-005-rbac/completed/STORY-014-chat-ui-login.plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ChatState's session credential (_token) is stored as a Reflex backend-only var (leading underscore), which Reflex never serializes to the client and no client-originated event can set. Chosen over a state var or cross-state read to guarantee no role is ever visible to or spoofable by the browser (PRD-005 Risk 5): every send() call re-resolves a fresh Identity from _token via resolve(), so the role is derived from the database on every call rather than cached anywhere on the class."}], "edges": [{"source": "agents_plans_prd_005_rbac_completed_story_014_chat_ui_login_plan_doc", "target": "chat_ui_chat_ui_state", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".ag