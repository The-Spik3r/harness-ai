{
  "default": {
    "tool_calls": [
      {
        "id": "call_rt_submit_default",
        "name": "submit_and_exit",
        "arguments": "{\"summary\":\"stub_openrouter: cline_realtime.json matched no rule, stopping.\",\"verified\":false}"
      }
    ]
  },
  "rules": [
    {
      "role": "assistant",
      "contains": "[harness] tool call",
      "last_role": "user",
      "advertises": "submit_and_exit",
      "content": "Understood, nothing was run.",
      "stream": {"chunk_chars": 6, "delay_ms": 60},
      "tool_calls": [
        {
          "id": "call_rt_submit_drop",
          "name": "submit_and_exit",
          "arguments": "{\"summary\":\"E2E-RT-DROP: the harness denied the call, nothing was run.\",\"verified\":true}"
        }
      ]
    },
    {
      "role": "system",
      "contains": "e2e021-015-cline-drop",
      "last_role": "user",
      "advertises": "run_commands",
      "content": "Cleaning up the database now.",
      "stream": {"chunk_chars": 6, "delay_ms": 60},
      "tool_calls": [
        {
          "id": "call_rt_drop",
          "name": "run_commands",
          "arguments": "{\"commands\":[\"sqlite3 app.db \\\"DROP TABLE users\\\"\"]}"
        }
      ]
    },
    {
      "role": "system",
      "contains": "e2e021-015-cline-text",
      "last_role": "user",
      "advertises": "submit_and_exit",
      "content": "Here is the answer you asked for. E2E-RT-ANSWER is the marker word. Nothing else is needed, so this is the end of the reply.",
      "stream": {"chunk_chars": 7, "delay_ms": 60},
      "tool_calls": [
        {
          "id": "call_rt_submit_text",
          "name": "submit_and_exit",
          "arguments": "{\"summary\":\"E2E-RT-TEXT: the answer was given, nothing else to do.\",\"verified\":true}"
        }
      ]
    },
    {
      "role": "system",
      "contains": "e2e021-015-cline-reason",
      "last_role": "user",
      "advertises": "submit_and_exit",
      "content": "After some thought the result is E2E-RT-REASONED and that is all.",
      "stream": {
        "chunk_chars": 8,
        "delay_ms": 60,
        "reasoning": "Thinking about @SENTINEL@ before answering. It stays private."
      },
      "tool_calls": [
        {
          "id": "call_rt_submit_reason",
          "name": "submit_and_exit",
          "arguments": "{\"summary\":\"E2E-RT-REASON: the reasoned answer was given.\",\"verified\":true}"
        }
      ]
    }
  ]
}
